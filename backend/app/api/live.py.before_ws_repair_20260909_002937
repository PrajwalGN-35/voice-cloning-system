@router.websocket("/ws")
async def live_websocket(websocket: WebSocket):
    origin = websocket.headers.get("origin")

    allowed_origins = [
        item.strip()
        for item in settings.frontend_origins.split(",")
        if item.strip()
    ]

    print(f"[LIVE WS DEBUG] ORIGIN={origin!r}")
    print(f"[LIVE WS DEBUG] ALLOWED={allowed_origins!r}")

    if origin and origin not in allowed_origins:
        print("[LIVE WS DEBUG] REJECT_REASON=ORIGIN")
        await websocket.close(code=1008)
        return

    token = websocket.query_params.get("token")
    token_valid = bool(token) and live_session_service.validate(token)

    print(f"[LIVE WS DEBUG] TOKEN_PRESENT={bool(token)}")
    print(f"[LIVE WS DEBUG] TOKEN_LENGTH={len(token) if token else 0}")
    print(f"[LIVE WS DEBUG] TOKEN_VALID={token_valid}")

    if not token_valid:
        print("[LIVE WS DEBUG] REJECT_REASON=TOKEN")
        await websocket.close(code=1008)
        return

    print("[LIVE WS DEBUG] ACCEPTING")
    await websocket.accept()

    stream_buffer = bytearray()
    sequence_number = 0
    last_analysis_bytes = 0

    try:
        await websocket.send_json(
            {
                "type": "CONNECTED",
                "success": True,
                "window_seconds": LIVE_WINDOW_SECONDS,
                "windowing": "rolling",
            }
        )

        while True:
            message = await websocket.receive()

            if message.get("type") == "websocket.disconnect":
                break

            if message.get("text") is not None:
                text = message["text"]

                if text == "PING":
                    await websocket.send_json({"type": "PONG"})

                continue

            chunk = message.get("bytes")

            if not chunk:
                continue

            if len(chunk) > MAX_CHUNK_BYTES:
                await websocket.send_json(
                    {
                        "type": "ERROR",
                        "message": "Live audio chunk exceeds maximum size.",
                    }
                )
                continue

            stream_buffer.extend(chunk)

            if len(stream_buffer) > MAX_STREAM_BYTES:
                # Keep the beginning of the MediaRecorder container intact.
                # Drop only older media data after successful decoding becomes
                # impossible, rather than treating each chunk independently.
                await websocket.send_json(
                    {
                        "type": "ERROR",
                        "message": "Live stream buffer exceeded maximum size.",
                    }
                )

                break

            await websocket.send_json(
                {
                    "type": "CHUNK_RECEIVED",
                    "bytes": len(chunk),
                    "buffer_bytes": len(stream_buffer),
                }
            )

            # Avoid repeatedly decoding the same byte range.
            # Browser timeslice is approximately one second, so once enough
            # additional data has arrived, attempt another five-second window.
            if (
                len(stream_buffer) > 0
                and len(stream_buffer) - last_analysis_bytes > 12000
            ):
                try:
                    decoded_wav = await asyncio.to_thread(
                        _decode_stream_to_wav,
                        bytes(stream_buffer),
                    )

                    window_wav = await asyncio.to_thread(
                        _extract_latest_window,
                        decoded_wav,
                    )

                    sequence_number += 1
                    last_analysis_bytes = len(stream_buffer)

                    await websocket.send_json(
                        {
                            "type": "WINDOW_READY",
                            "window_id": f"live-{sequence_number}",
                            "sequence_number": sequence_number,
                            "window_seconds": LIVE_WINDOW_SECONDS,
                        }
                    )

                    result = await asyncio.to_thread(
                        _analyze_window,
                        window_wav,
                        sequence_number,
                    )

                    await websocket.send_json(result)

                except Exception as exc:
                    await websocket.send_json(
                        {
                            "type": "ANALYSIS_ERROR",
                            "success": False,
                            "sequence_number": sequence_number + 1,
                            "message": str(exc),
                        }
                    )

    except WebSocketDisconnect:
        pass

    finally:
        live_session_service.revoke_session(token)






